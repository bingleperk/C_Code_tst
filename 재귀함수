///////////// 재귀함수로 거듭제곱 구하기


#include <stdio.h>

int je(int n, int j)
{
    if (n==1)
    {
        return 1;
    }
    else if (j<=1)
    {
        return n;
    }
    
    return n*je(n , (j-1));
}

int main()
{
    int n,j;
    scanf("%d %d",&n, &j);

    printf("n의 j제곱은 %d", je(n,j));


    return 0;
}

